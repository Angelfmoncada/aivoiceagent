{
  "name": "voice-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time voice agent playground powered by the Gemini Live API",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @voice-studio/server --filter @voice-studio/web dev",
    "dev:server": "pnpm --filter @voice-studio/server dev",
    "dev:web": "pnpm --filter @voice-studio/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @voice-studio/server --filter @voice-studio/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "smoke:live": "pnpm --filter @voice-studio/server smoke:live",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  }
}
