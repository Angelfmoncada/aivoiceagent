{
  "name": "@voice-studio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@google/genai": "^3.6.1",
    "@voice-studio/shared": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "ws": "^8.21.0"
  }
}
