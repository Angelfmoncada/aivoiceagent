# Voice Studio server configuration. Copy to apps/server/.env and fill in.
# This file is read only by the Node.js server. Never put the API key in apps/web.

# Required. Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live API model. Verified Live-capable ids (Nov 2026): gemini-2.5-flash-native-audio-preview-12-2025
# (default; works on the free tier), gemini-3.8-live and gemini-3.1-flash-live-preview (need paid quota),
# or the alias gemini-2.5-flash-native-audio-latest.
# List what your key can use: GET https://generativelanguage.googleapis.com/v1beta/models
# and look for "bidiGenerateContent" in supportedGenerationMethods.
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Interface and port. Keep 127.0.0.1 for local development.
HOST=127.0.0.1
PORT=8787

# Comma-separated browser origins allowed to open the WebSocket and read /health.
# Origin checks block other websites in a browser; they are NOT authentication.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Abuse controls (in-memory, single process).
MAX_CONCURRENT_SESSIONS=3
SESSION_STARTS_PER_MINUTE=6
MAX_SESSION_MINUTES=15

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
